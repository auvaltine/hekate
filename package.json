{
	"name": "hekate",
	"version": "1.0.7",
	"description": "JavaScript witchcraft: magically lightweight, nimble, comprehensive, full stack Node.js framework.",
	"homepage": "https://hekate.app/core",
	"funding": "https://hekate.app/donate",
	"repository": {
		"type": "git",
		"url": "https://hekate.app/r/hekate"
	},
	"bugs": {
		"email": "hi@hekate.app",
		"url": "https://github.com/auvaltine/hekate/issues"
	},
	"license": "ISC",
	"author": {
		"name": "Abhayā Auva",
		"email": "abhaya@hekate.app",
		"url": "https://hekate.app"
	},
	"config": {
		"allow": { "$value": [ "/(?:robots|sitemap)\\.txt$", "/sitemap\\.xml$", "/content/modules/client/.*" ] },
		"cluster": { "$value": 1 },
		"environment": { "$value": "development" },
		"http": { "port": { "$value": 80 } },
		"https": { "port": { "$value": 443 } },
		"log": {
			"cycle": { "$value": 7 },
			"http": { "$value": "%a \"%r\" %s %B %Fms \"%f\" \"%u\" %d" },
			"size": { "$value": 10e+6 },
			"trim": { "$value": 256 },
			"trimText": { "$value": "%s more characters" }
		},
		"deny": { "$value": [ ".*/[^/]+\\.[a-z]+$" ] },
		"session": { "expires": { "$value": 15 } },
		"template": {
			"directory": { "$value": "/assets" },
			"client": { "$value": true },
			"js": { "$value": [] },
			"css": { "$value": [] }
		},
		"title": { "separator": { "$value": "-" } },
		"upload": { "max": { "$value": 4e+6 }, "file": { "$value": 2e+6 } },
		"view": {}
	},
	"os": [ "!win32" ],
	"engines": {
		"node": ">=18.0.0"
	},
	"exports": {
		".": "./server/index.js",
		"./console": "./server/console.js",
		"./cookie": "./server/cookie.js",
		"./index": "./server/index.js",
		"./limiter": "./server/limiter.js",
		"./mime": "./server/mime.js",
		"./network": "./server/network.js",
		"./parser": "./server/parser.js",
		"./primary": "./server/primary.js",
		"./primitive/array": "./server/primitive/array.js",
		"./primitive/date": "./server/primitive/date.js",
		"./primitive/number": "./server/primitive/number.js",
		"./primitive/object": "./server/primitive/object.js",
		"./primitive/string": "./server/primitive/string.js",
		"./request": "./server/request.js",
		"./response": "./server/response.js",
		"./server": "./server/server.js",
		"./session": "./server/session.js",
		"./template": "./server/template.js",
		"./websocket": "./server/websocket.js"
	},
	"scripts": {
		"postinstall": "./index.mjs postinstall",
		"update": "./index.mjs update",
		"restart": "./index.mjs restart",
		"start": "./index.mjs start",
		"stop": "./index.mjs stop",
		"build": "./index.mjs build",
		"help": "./index.mjs help"
	},
	"dependencies": {
		"@babel/core": "^7.19.0",
		"babel-preset-minify": "^0.5.0",
		"mongodb": "^4.9.0",
		"sass": "^1.54.0"
	}
}
